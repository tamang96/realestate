# NTREIS RESO Web API connection.
# Get these from NTREIS (or the data vendor NTREIS issues your feed through)
# after your IDX/VOW/broker data license is approved. Never commit real values.

# Base OData URL, e.g. https://<host>/reso/odata  (no trailing slash)
RESO_BASE_URL=

# Option A: a static bearer token issued with your feed
RESO_ACCESS_TOKEN=

# Option B: OAuth2 client credentials (used when RESO_ACCESS_TOKEN is empty)
RESO_TOKEN_URL=
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_SCOPE=api

# Optional: OData entity set name for listings (default: Property)
RESO_PROPERTY_RESOURCE=Property
